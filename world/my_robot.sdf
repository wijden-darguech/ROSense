<?xml version="1.0"?>
<sdf version="1.9">
  <world name="my_world">
  <!-- Moteur physique -->
    <physics name="10ms" type="dartsim">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

 <!-- Plugins nécessaires (physique, rendu, contacts) -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
  <render_engine>ogre2</render_engine>
</plugin>
    <!-- Gravité -->
    <gravity>0 0 -9.8</gravity>
      <!-- Lumière -->
    <light type="directional" name="soleil">
      <!-- vers quoi pointe la lumière --><!-- vecteur vers le bas -->
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Le sol -->
    <model name="sol">
      <static>true</static>
      <link name="sol_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
       <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
  <material>
   <!--ombre-->
    <ambient>0.3 0.3 0.3 1</ambient>
    <!--couleur principale-->
    <diffuse>0.3 0.3 0.3 1</diffuse>
    <!--reflets-->
    <specular>0.1 0.1 0.1 1</specular>
  </material>
</visual>
      </link>
    </model>
  </world>
</sdf>