<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ Plugin de contrôle différentiel ============ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
    
      <left_joint>lwheel_basejoint</left_joint>
      <right_joint>rwheel_basejoint</right_joint>
      <wheel_separation>${b + length}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>footprint</child_frame_id>

    </plugin>
    
  <plugin filename="gz-sim-joint-state-publisher-system"
          name="gz::sim::systems::JointStatePublisher"/>
 
  </gazebo>

   <!-- ========================================================= -->
  <!-- Paramètres LiDAR 2D                                        -->
  <!-- ========================================================= -->
  <xacro:property name="lidar_update_rate" value="10"/>
  <!--le nombre des segments-->
  <xacro:property name="lidar_samples" value="721"/>
  <xacro:property name="lidar_min_angle" value="-3.141592653589793"/>
  <xacro:property name="lidar_max_angle" value="3.141592653589793"/>
  <xacro:property name="lidar_min_range" value="0.12"/>
  <xacro:property name="lidar_max_range" value="12.0"/>
  <xacro:property name="lidar_range_resolution" value="0.01"/>
  <!--autour de quoi est le noise-->
  <xacro:property name="lidar_noise_mean" value="0.0"/>
  <!--l'incertitude-->
  <xacro:property name="lidar_noise_stddev" value="0.01"/>
  <!-- ========================================================= -->
  <!-- Paramètres IMU                                             -->
  <!-- ========================================================= -->
  <xacro:property name="imu_update_rate" value="100"/>
  <xacro:property name="gyro_noise_mean" value="0.0"/>
  <xacro:property name="gyro_noise_stddev" value="2.0e-4"/>
  <xacro:property name="gyro_bias_mean" value="7.5e-6"/>
  <xacro:property name="gyro_bias_stddev" value="8.0e-7"/>
  <xacro:property name="accel_noise_mean" value="0.0"/>
  <xacro:property name="accel_noise_stddev" value="1.7e-2"/>
  <xacro:property name="accel_bias_mean" value="0.1"/>
  <xacro:property name="accel_bias_stddev" value="0.001"/>
<xacro:macro name="gaussian_noise_with_bias" params="mean stddev bias_mean bias_stddev">
  <noise type="gaussian">
    <mean>${mean}</mean>
    <stddev>${stddev}</stddev>
    <bias_mean>${bias_mean}</bias_mean>
    <bias_stddev>${bias_stddev}</bias_stddev>
  </noise>
</xacro:macro>






  <!-- ============ Friction et couleur des roues motrices ============ -->
  <gazebo reference="lwheel_link">
    <material>Gazebo/Blue</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="rwheel_link">
    <material>Gazebo/Blue</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ============ Roue folle : faible friction pour qu'elle glisse librement ============ -->
  <gazebo reference="fwheel_link">
    <material>Gazebo/Blue</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- ============ Couleur du châssis ============ -->
  <gazebo reference="base_link">
    <material>Gazebo/Red</material>
  </gazebo>
 <!-- ========================================================= -->
  <!-- 1) LiDAR 2D  ->  sensor_msgs/msg/LaserScan                 -->
  <!-- ========================================================= -->
  
  <gazebo reference="lidar_link">

  <sensor name="lidar_2d" type="gpu_lidar">

    <pose>0 0 0 0 0 0</pose>

    <topic>scan</topic>

    <update_rate>${lidar_update_rate}</update_rate>

    <always_on>true</always_on>

    <visualize>true</visualize>

    <lidar>

      <scan>
        <horizontal>
          <samples>${lidar_samples}</samples>
          <resolution>1</resolution>
          <min_angle>${lidar_min_angle}</min_angle>
          <max_angle>${lidar_max_angle}</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>${lidar_min_range}</min>
        <max>${lidar_max_range}</max>
        <resolution>${lidar_range_resolution}</resolution>
      </range>

      <noise>
        <type>gaussian</type>
        <mean>${lidar_noise_mean}</mean>
        <stddev>${lidar_noise_stddev}</stddev>
      </noise>

    </lidar>

  </sensor>

</gazebo>
  <!-- ========================================================= -->
  <!-- 2) IMU  ->  sensor_msgs/msg/Imu                            -->
  <!-- ========================================================= -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>imu</topic>
      
      <update_rate>${imu_update_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <!-- Orientation exprimée dans un repère monde ENU -->
        <orientation_reference_frame>
          <localization>ENU</localization>
        </orientation_reference_frame>

        <!-- Vitesse angulaire (rad/s) -->
        <angular_velocity>
          <x>
            <xacro:gaussian_noise_with_bias mean="${gyro_noise_mean}"
                                            stddev="${gyro_noise_stddev}"
                                            bias_mean="${gyro_bias_mean}"
                                            bias_stddev="${gyro_bias_stddev}"/>
          </x>
          <y>
            <xacro:gaussian_noise_with_bias mean="${gyro_noise_mean}"
                                            stddev="${gyro_noise_stddev}"
                                            bias_mean="${gyro_bias_mean}"
                                            bias_stddev="${gyro_bias_stddev}"/>
          </y>
          <z>
            <xacro:gaussian_noise_with_bias mean="${gyro_noise_mean}"
                                            stddev="${gyro_noise_stddev}"
                                            bias_mean="${gyro_bias_mean}"
                                            bias_stddev="${gyro_bias_stddev}"/>
          </z>
        </angular_velocity>

        <!-- Accélération linéaire (m/s^2) -->
        <linear_acceleration>
          <x>
            <xacro:gaussian_noise_with_bias mean="${accel_noise_mean}"
                                            stddev="${accel_noise_stddev}"
                                            bias_mean="${accel_bias_mean}"
                                            bias_stddev="${accel_bias_stddev}"/>
          </x>
          <y>
            <xacro:gaussian_noise_with_bias mean="${accel_noise_mean}"
                                            stddev="${accel_noise_stddev}"
                                            bias_mean="${accel_bias_mean}"
                                            bias_stddev="${accel_bias_stddev}"/>
          </y>
          <z>
            <xacro:gaussian_noise_with_bias mean="${accel_noise_mean}"
                                            stddev="${accel_noise_stddev}"
                                            bias_mean="${accel_bias_mean}"
                                            bias_stddev="${accel_bias_stddev}"/>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
</robot>